# Cursor API Configuration
# Copy this file to .env and fill in your actual API key

# Get your Cursor API key from: https://cursor.sh/settings
VITE_CURSOR_API_KEY=your_cursor_api_key_here

# Cursor API Base URL (usually this doesn't need to be changed)
VITE_CURSOR_API_URL=https://api.cursor.sh/v1

# Optional: Set custom model (default: cursor-small)
VITE_CURSOR_MODEL=cursor-small